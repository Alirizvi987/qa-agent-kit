{
  "name": "qa-agent-kit",
  "version": "1.0.0",
  "description": "Clone, describe your project, and get a ready QA workspace: house rules, rule files, AI test agents for Claude Code, and starter scripts for web and Android testing.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node kit/server.mjs",
    "generate": "node kit/generate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "health": "node scripts/health-check.mjs",
    "signin": "node scripts/signin-shot.mjs",
    "save-session": "node scripts/save-session.mjs",
    "new-run": "node scripts/new-run.mjs",
    "add-to": "node scripts/add-to.mjs",
    "report": "node scripts/report.mjs",
    "new-user": "node scripts/new-user.mjs",
    "test": "node kit/selftest.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
