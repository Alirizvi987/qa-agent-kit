{
  "project": {
    "name": "Acme Bookings",
    "summary": "Acme Bookings lets customers find a salon or clinic and book an appointment. Businesses sign up, get approved by Acme staff, and publish their services. Customers pay a monthly membership for discounts.",
    "owner": "Sara Ahmed",
    "team": "QA"
  },
  "environments": [
    { "name": "dev", "url": "https://dev.acme-bookings.test", "production": false },
    { "name": "staging", "url": "https://staging.acme-bookings.test", "production": false },
    { "name": "production", "url": "https://acme-bookings.example", "production": true }
  ],
  "portals": [
    { "name": "Customer website", "slug": "customer", "url": "https://app.dev.acme-bookings.test", "login_path": "/login" },
    { "name": "Business portal", "slug": "business", "url": "https://business.dev.acme-bookings.test", "login_path": "/login" },
    { "name": "Admin panel", "slug": "admin", "url": "https://admin.dev.acme-bookings.test", "login_path": "/login" }
  ],
  "roles": [
    { "name": "Customer", "summary": "books appointments and pays a monthly membership", "portal": "customer", "needs_approval": false },
    { "name": "Business", "summary": "a salon or clinic that lists services and takes bookings", "portal": "business", "needs_approval": true },
    { "name": "Admin", "summary": "Acme staff who approve businesses and manage settings", "portal": "admin", "is_admin": true }
  ],
  "states": ["New sign-up", "Waiting for approval", "Changes requested", "Approved", "Expired", "Suspended", "Rejected", "Deleted"],
  "mobile": {
    "android": true,
    "ios": false,
    "package": "com.acme.bookings",
    "device": "Samsung Galaxy S22",
    "width": 1080,
    "height": 2340,
    "dpi": 420,
    "emulators": 3
  },
  "sources": {
    "prd": "https://docs.example/acme-bookings-prd",
    "designs": [
      { "name": "Web designs", "url": "https://www.figma.com/design/EXAMPLE-WEB" },
      { "name": "Mobile designs", "url": "https://www.figma.com/design/EXAMPLE-MOBILE" }
    ],
    "api_docs": "https://dev.acme-bookings.test/api/docs",
    "tracker": "Jira",
    "tracker_url": "https://acme.atlassian.example/jira/BOOK",
    "repos": [
      { "name": "Website", "url": "https://github.com/acme/bookings-web" },
      { "name": "Server", "url": "https://github.com/acme/bookings-api" },
      { "name": "Mobile app", "url": "https://github.com/acme/bookings-mobile" }
    ]
  },
  "mailbox": {
    "address": "qa.team@acme.example",
    "alias_pattern": "qa.team+{alias}@acme.example",
    "connector": "Gmail"
  },
  "payments": { "provider": "Stripe", "test_card": "4242 4242 4242 4242" },
  "login": {
    "email_selector": "input[type=email]",
    "password_selector": "input[type=password]",
    "submit_selector": "button[type=submit]",
    "success_text": ""
  },
  "rules": {
    "recheck_times": 2,
    "prd_first": true,
    "min_design_diff_px": 2,
    "no_cleanup": true,
    "headless_first": true,
    "severity": ["P1", "P2", "P3"],
    "report": "A shareable web page (Claude artifact)"
  },
  "widths": [1440, 1280, 390]
}
